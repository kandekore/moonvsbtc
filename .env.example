# Bitcoin vs The Moon - environment configuration
#
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Production database. MySQL, utf8mb4.
#   mysql+pymysql://USER:PASSWORD@localhost/DBNAME?charset=utf8mb4
# Percent-encode any @ : / ? # [ ] characters in the password.
# For local development you may instead use: sqlite:///btcmoon.db
DATABASE_URL=mysql+pymysql://cpuser_btcmoon:CHANGEME@localhost/cpuser_btcmoon?charset=utf8mb4

# Public base URL, no trailing slash. Used for canonical URLs and the sitemap.
SITE_URL=https://bitcoinvsthemoon.com

# ---------------------------------------------------------------------------
# AI PROVIDER
# ---------------------------------------------------------------------------
# WITHOUT THIS KEY the system still works: briefings, outlooks and the
# Companion fall back to a complete deterministic, zero-cost summary built from
# market, lunar, natal and protocol data. Supplying the key activates the
# AI write-up. Nothing else needs to change.
OPENAI_API_KEY=

# Optional: an OpenAI-compatible endpoint (leave blank for OpenAI itself).
OPENAI_BASE_URL=

# Master switch. Set false to stop all AI generation without removing the key.
AI_ENABLED=true

# Model per tier. Cheap work must never silently use the expensive model.
# These are overridable per task at runtime in /admin/settings/.
AI_MODEL_CHEAP=gpt-4o-mini
AI_MODEL_STANDARD=gpt-4o-mini
AI_MODEL_STRONG=gpt-4o
AI_MAX_OUTPUT_TOKENS=2000

# ---------------------------------------------------------------------------
# AI BUDGET CONTROL (mandatory)
# ---------------------------------------------------------------------------
# Hard ceilings in USD. At the monthly ceiling ALL non-essential AI generation
# stops; the public site, news ingestion, market data, scheduled jobs and the
# admin area continue running. Warnings fire at 50%, 75% and 90%.
AI_MONTHLY_BUDGET_USD=25.00
AI_DAILY_BUDGET_USD=5.00

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
SITE_NAME=Bitcoin vs The Moon
SITE_TAGLINE=A public longitudinal experiment: can lunar cycles tell us anything useful about Bitcoin?
EDITOR_NAME=Darren Kandekore
# Interactive pivot explorer (the Streamlit app.py), proxied at this path.
# Leave EMPTY to remove the "Explorer" link from the site navigation.
EXPLORER_URL=/app/
TIMEZONE=Europe/London

# ---------------------------------------------------------------------------
# ENTITLEMENTS
# ---------------------------------------------------------------------------
# Everything is free through 31 Dec 2026. The paywall machinery is built and
# tested but stays disabled until BOTH of these say otherwise.
PAYWALL_ENABLED=false
FREE_UNTIL=2026-12-31

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# Set true once HTTPS is live (it will be, behind LiteSpeed + AutoSSL).
SESSION_COOKIE_SECURE=true
FLASK_ENV=production
FLASK_DEBUG=false

# Rate-limit backend. memory:// is per-process and fine for a single worker;
# use redis://localhost:6379 if you run more than one.
RATELIMIT_STORAGE_URI=memory://

# ---------------------------------------------------------------------------
# MARKET DATA
# ---------------------------------------------------------------------------
MARKET_PROVIDER=yfinance
MARKET_CACHE_TTL_MINUTES=30
BTCMOON_CACHE_DIR=.cache

# Optional. Not required - yfinance needs no credential. The adapter interface
# exists so the provider can be swapped without touching research code.
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# NEWS INGESTION
# ---------------------------------------------------------------------------
NEWS_MAX_ITEMS_PER_FEED=25
NEWS_FETCH_TIMEOUT=20
NEWS_USER_AGENT=BitcoinVsTheMoon/1.0 (+https://bitcoinvsthemoon.com)

# ---------------------------------------------------------------------------
# SCHEDULED BRIEFINGS
# ---------------------------------------------------------------------------
# Informational: the actual schedule lives in crontab. See DEPLOYMENT.md.
MORNING_BRIEF_HOUR=7
EVENING_BRIEF_HOUR=18
